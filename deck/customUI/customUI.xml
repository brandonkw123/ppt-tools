<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon>
    <tabs>
      <tab id="tabPPTTools" label="PPT Tools">

        <group id="grpPosition" label="Position">
          <button id="btnSwapPositions"     label="Swap Positions"  size="large" onAction="SwapPositions"  imageMso="ArrowsMore"/>
          <button id="btnCopyPosition"      label="Copy Position"   size="large" onAction="CopyPosition"   imageMso="Copy"/>
          <button id="btnPastePosition"     label="Paste Position"  size="large" onAction="PastePosition"  imageMso="Paste"/>
        </group>

        <group id="grpSize" label="Size">
          <button id="btnMatchWidth"        label="Match Width"         size="normal" onAction="MatchWidth"        imageMso="SizeToWidest"/>
          <button id="btnMatchHeight"       label="Match Height"        size="normal" onAction="MatchHeight"       imageMso="SizeToTallest"/>
          <button id="btnMatchWidthHeight"  label="Match Width + Height" size="normal" onAction="MatchWidthAndHeight" imageMso="SizeToControlHeightAndWidth"/>
          <separator id="sepSize1"/>
          <button id="btnCopySize"          label="Copy Size"           size="normal" onAction="CopySize"          imageMso="TableResize"/>
          <button id="btnPasteWidth"        label="Paste Width"         size="normal" onAction="PasteWidth"        imageMso="ShapeWidth"/>
          <button id="btnPasteHeight"       label="Paste Height"        size="normal" onAction="PasteHeight"       imageMso="ShapeHeight"/>
          <button id="btnPasteWidthHeight"  label="Paste Width + Height" size="normal" onAction="PasteWidthAndHeight" imageMso="DiagramScale"/>
        </group>

        <group id="grpStretch" label="Stretch to Meet">
          <button id="btnStretchUp"         label="Up" screentip="Stretch Up to Meet"    size="large" onAction="StretchUp"    imageMso="ObjectsAlignTopSmart"
                  supertip="Moves the top edge of each selected shape up to the bottom edge of the reference shape (the one furthest back), so they touch."/>
          <button id="btnStretchDown"       label="Down" screentip="Stretch Down to Meet"  size="large" onAction="StretchDown"  imageMso="ObjectsAlignBottomSmart"
                  supertip="Moves the bottom edge of each selected shape down to the top edge of the reference shape (the one furthest back), so they touch."/>
          <button id="btnStretchLeft"       label="Left" screentip="Stretch Left to Meet"  size="large" onAction="StretchLeft"  imageMso="ObjectsAlignLeftSmart"
                  supertip="Moves the left edge of each selected shape to the right edge of the reference shape (the one furthest back), so they touch."/>
          <button id="btnStretchRight"      label="Right" screentip="Stretch Right to Meet" size="large" onAction="StretchRight" imageMso="ObjectsAlignRightSmart"
                  supertip="Moves the right edge of each selected shape to the left edge of the reference shape (the one furthest back), so they touch."/>
        </group>

        <group id="grpStretchMatch" label="Stretch to Match">
          <button id="btnStretchUpMatch"    label="Up" screentip="Stretch Up to Match"    size="large" onAction="StretchUpMatch"    imageMso="FillUp"
                  supertip="Moves the top edge of each selected shape to the top edge of the reference shape (the one furthest back), so the top edges line up."/>
          <button id="btnStretchDownMatch"  label="Down" screentip="Stretch Down to Match"  size="large" onAction="StretchDownMatch"  imageMso="FillDown"
                  supertip="Moves the bottom edge of each selected shape to the bottom edge of the reference shape (the one furthest back), so the bottom edges line up."/>
          <button id="btnStretchLeftMatch"  label="Left" screentip="Stretch Left to Match"  size="large" onAction="StretchLeftMatch"  imageMso="FillLeft"
                  supertip="Moves the left edge of each selected shape to the left edge of the reference shape (the one furthest back), so the left edges line up."/>
          <button id="btnStretchRightMatch" label="Right" screentip="Stretch Right to Match" size="large" onAction="StretchRightMatch" imageMso="FillRight"
                  supertip="Moves the right edge of each selected shape to the right edge of the reference shape (the one furthest back), so the right edges line up."/>
        </group>

        <group id="grpUtilities" label="Utilities">
          <button id="btnEmailSlides"       label="Email Selected Slides" size="large" onAction="EmailSelectedSlides" imageMso="SendCopySendToMailRecipient"/>
          <button id="btnEmailDeck"         label="Email Whole Deck"      size="large" onAction="EmailWholeDeck"      imageMso="CreateEmail"/>
          <button id="btnConvertPDF"        label="Convert to PDF"        size="large" onAction="ConvertToPDF"        imageMso="PublishToPdfOrEdoc"/>
        </group>

        <group id="grpCleanup" label="Cleanup">
          <button id="btnRemoveComments"      label="Remove All Comments"     size="large" onAction="RemoveAllComments"      imageMso="ReviewDeleteComment"/>
          <button id="btnRemoveNotes"         label="Remove All Speaker Notes" size="large" onAction="RemoveAllNotes"        imageMso="TableOfContentsRemove"/>
          <button id="btnRemoveCommentsNotes" label="Remove Comments + Notes" size="large" onAction="RemoveCommentsAndNotes" imageMso="ReviewDeleteAllMarkupInPresentation"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
